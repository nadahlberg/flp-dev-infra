# Copy to .env (gitignored) for local `pulumi up`. CI gets the same values from
# GitHub Actions secrets / variables — see README.md.

# Pulumi Cloud + DigitalOcean
PULUMI_ACCESS_TOKEN=
DIGITALOCEAN_TOKEN=

# GitHub classic PAT with repo, read:packages and write:packages. Pushes the
# app images to ghcr.io and lets the cluster pull them.
GH_TOKEN=

# The CourtListener superuser the bootstrap job creates (username DEV_USER_NAME).
# The same password is reused for the test1..testN accounts.
DEV_USER_NAME=dev
DEV_USER_EMAIL=
DEV_USER_PASSWORD=

# Optional: a courtlistener.com API token, for pulling real data with
# `manage.py clone_from_cl` from inside the cluster.
CL_API_TOKEN=

# Optional: Sentry DSNs for the two apps.
CL_SENTRY_DSN=
MCP_SENTRY_DSN=

# Where the app source trees are, relative to infra/. CI checks the app repos
# out beside this one; locally the siblings in the project folder are used.
CL_CONTEXT=../../courtlistener
MCP_CONTEXT=../../courtlistener-api-client

# Image tags. CI sets these to <app short sha>-<run number>.
CL_IMAGE_TAG=dev
MCP_IMAGE_TAG=dev
